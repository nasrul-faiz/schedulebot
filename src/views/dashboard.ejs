                            </button>
                            <button type="button" class="complex-menu-item" data-command-menu-action="fill-trigger" data-trigger-value=".menu">
                              <span>.menu</span>
                            </button>
                            <button type="button" class="complex-menu-item" data-command-menu-action="fill-trigger" data-trigger-value=".help">
                              <span>.help</span>
